{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdr Workbench",
  "version": "0.1.1",
  "identifier": "online.zxbdwy.herdr-workbench",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm web:build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Herdr Workbench",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
